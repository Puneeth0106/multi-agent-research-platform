# Copy to .env for local shell / container use. No dotenv loader is implemented.
# The API reads only AWS_REGION from its environment, then fetches the fixed
# AWS Secrets Manager secret research-agent/config. See config/secrets.example.json.
AWS_REGION=us-east-1

# TensorZero container environment (ECS injects these from Secrets Manager).
OPENAI_API_KEY=REPLACE_ME
GROQ_API_KEY=REPLACE_ME

# Optional dashboard process environment. Use a reachable research API and Redis.
TARGET_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0

# AWS credentials come from an AWS profile, SSO session, or attached IAM role.
# Never paste real AWS access keys into this example.
